# PostHog project token is a write-only public key (safe in frontend code).
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Analytics only runs in production builds. Set to "true" to test it in `pnpm dev`.
VITE_ANALYTICS_IN_DEV=false
# Sentry DSN (public by design). Leave empty to disable error reporting.
VITE_SENTRY_DSN=
VITE_MONITORING_IN_DEV=false

# --- Set these before deploying (used for canonical URLs, sitemap, legal pages) ---
VITE_SITE_URL=https://devtools-co.vercel.app
VITE_CONTACT_EMAIL=hellothefreelancer@gmail.com
VITE_OPERATOR_NAME=DevTools
